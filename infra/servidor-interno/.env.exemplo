# ─── Configuração do servidor ─────────────────────────────────
# Copie para .env com:  sh scripts/gerar-segredos.sh
# O script preenche sozinho os SEGREDOS. Os demais campos, edite à mão.
# O .env nunca vai para o Git (o repositório é público).

# ── Endereço ──────────────────────────────────────────────────
# Nome do servidor na rede interna, como os computadores o acessam.
# Precisa bater com o nome no certificado HTTPS.
NOME_DO_SERVIDOR=producao.empresa.local
ENDERECO=https://producao.empresa.local

# ── E-mail (Office 365) ───────────────────────────────────────
# Usado para a recuperação de senha. Ver a seção "E-mail" do README:
# a TI precisa liberar o envio autenticado (SMTP AUTH) para esta caixa.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USUARIO=dash.producao@empresa.com.br
SMTP_SENHA=
# Precisa ser a própria caixa do SMTP_USUARIO (ou uma com "Enviar como").
SMTP_REMETENTE=dash.producao@empresa.com.br
SMTP_NOME_REMETENTE=Dash de Produção

# true  = o cadastro não pede confirmação por e-mail (o administrador
#         aprova cada pessoa de qualquer forma).
# false = a pessoa precisa clicar no link do e-mail antes de entrar.
CONFIRMAR_CADASTRO_AUTOMATICAMENTE=true

# ── Sessão ────────────────────────────────────────────────────
# Validade do login, em segundos. O app renova sozinho enquanto está aberto.
JWT_EXPIRY=3600

# ── Segredos (o gerar-segredos.sh preenche) ───────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
# Vai dentro do site; pode ser vista por quem abre o app. É assim mesmo:
# quem protege os dados são as regras do banco (RLS), não esta chave.
ANON_KEY=
# NUNCA vai para o site nem para ninguém fora da TI: ela ignora as regras.
SERVICE_ROLE_KEY=
