{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dash",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8090
    },
    {
      "name": "dash-supabase",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "app/vite.config.ts", "--mode", "supabase", "--port", "8091", "--strictPort"],
      "port": 8091
    },
    {
      "name": "dash-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "app/vite.config.ts", "--mode", "mock", "--port", "8092", "--strictPort"],
      "port": 8092
    }
  ]
}
